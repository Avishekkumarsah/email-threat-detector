# ==============================================================================
# EMAIL THREAT DETECTOR - PRODUCTION ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in your production values.
# NEVER commit your real .env file to git or version control!
# ==============================================================================

# --- Required Production Settings ---
# Generate a strong secret key (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=dev-secret-change-me-to-a-strong-random-key-in-production

# --- Optional Database Settings ---
# Leave blank to default to SQLite (scans.db).
# For cloud platforms with ephemeral storage (e.g. Render, Heroku), provide a PostgreSQL connection URI:
# DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# --- Optional External API Keys ---
# VirusTotal API Key for enhanced URL and attachment hash lookup
VT_API_KEY=

# --- Real-Time Inbox Monitoring Settings ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
POLL_INTERVAL_SECONDS=30

# --- Security & HTTPS Settings ---
# Set SESSION_COOKIE_SECURE=True when running over HTTPS in production
SESSION_COOKIE_SECURE=False

# --- Super Admin Account (fixed site-owner login) ---
# This account is auto-created on first startup. Change these before deploying!
# On Render / cloud: set ADMIN_EMAIL and ADMIN_PASSWORD in the Environment tab.
ADMIN_EMAIL=admin@emailthreat.com
ADMIN_PASSWORD=Admin@1234
